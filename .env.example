# Environment Variables for GreenKarachi

# Server Configuration
SERVER_PORT=3000
SERVER_HOST=localhost
NODE_ENV=development

# Database Configuration (for Phase 2)
# Database credentials should be added during Phase 2
# Example placeholder structure:
# DATABASE_URL=postgresql://username:password@localhost:5432/greenkarachi_db

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# API Configuration
API_PREFIX=/api
API_VERSION=v1

# JWT Configuration (for Phase 2)
# JWT_SECRET=your_jwt_secret_key_here
# JWT_EXPIRES_IN=24h

# Upload Configuration (for Phase 3)
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp

# Rate Limiting (for Phase 7)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Cache Configuration (for Phase 8)
REDIS_URL=redis://localhost:6379

# Email Configuration (for Phase 7)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_email_password
# SMTP_FROM=noreply@greenkarachi.com

# Cloud Storage Configuration (for Phase 3)
# AWS_S3_ACCESS_KEY_ID=your_access_key_id
# AWS_S3_SECRET_ACCESS_KEY=your_secret_access_key
# AWS_S3_REGION=us-east-1
# AWS_S3_BUCKET_NAME=your-bucket-name

# Application Configuration
LOG_LEVEL=debug
PORT=3000
HOST=localhost

# Feature Flags (for testing/phases)
ENABLE_REGISTRATION=true
ENABLE_VERIFICATION=true
ENABLE_COLLABORATION=true
ENABLE_PROJECTS=true
