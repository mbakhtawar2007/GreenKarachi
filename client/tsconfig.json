
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    "allowJs": false,
    "skipLibCheck": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "strict": true,
    "forceConsistentCasingInFileNames": true,

    "moduleResolution": "bundler",
    "resolveJsonModule": true,

    "declaration": false,
    "noEmit": true,

    "jsx": "react-jsx"
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
